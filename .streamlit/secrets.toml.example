# -----------------------------------------------------------------------------
# TEMPLATE ONLY - do NOT put real secrets in a committed file.
# On Streamlit Community Cloud, paste these (with real values) into:
#   App -> Settings -> Secrets
# Locally, copy this file to .streamlit/secrets.toml (which is git-ignored).
# -----------------------------------------------------------------------------

# Shared password your colleagues type to open the app.
app_password = "choose-a-strong-shared-password"

# Your Anthropic API key (enables synthesized answers). Keep this private.
ANTHROPIC_API_KEY = "sk-ant-..."

# Or use OpenAI instead:
# OPENAI_API_KEY = "sk-..."
